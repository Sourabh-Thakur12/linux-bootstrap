{
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "cssPriority": "application",

  "control-center-margin-top": 8,
  "control-center-margin-bottom": 0,
  "control-center-margin-right": 8,
  "control-center-margin-left": 0,

  "notification-window-width": 380,
  "control-center-width": 420,
  "control-center-height": 0,

  "fit-to-screen": false,
  "relative-timestamps": true,

  "timeout": 5,
  "timeout-low": 2,
  "timeout-critical": 0,
  "notification-2fa-timeout": 15,

  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "notification-icon-size": 48,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-inline-replies": false,

  "hide-on-clear": false,
  "hide-on-action": true,
  "inhibit-notifications-on-fullscreen": false,

  "transition-time": 200,

  "scripts": {
    "brightness-dedup": {
      "summary": "Brightness",
      "run-script-before-notification": false
    }
  },

  "notification-visibility": {
    "brightness-replace": {
      "state": "muted",
      "override-urgency": "low",
      "app-name": "brightnessctl",
      "summary": "Brightness"
    },
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notification Center",
      "clear-all-button": true,
      "button-text": "󰎟  Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "mpris": {
      "image-size": 72,
      "image-radius": 8
    },
    "notifications": {
      "notifications-visibility": true
    }
  }
}
