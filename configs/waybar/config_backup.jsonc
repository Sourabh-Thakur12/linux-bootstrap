{
  "layer": "top",
  "position": "top",
  "height": 32,
/*  "margin-top": 5,
  "margin-left": 5,
  "margin-right": 5,
  "margin-bottom": 5,
*/

  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": 3,

  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],

  "modules-right": [
    "pulseaudio",
    "disk",
    "keyboard-state",
    "memory",
    "cpu",
    "network",
    "battery",
    "clock"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },

  "sway/window": {
    "max-length": 60
  },

  "pulseaudio": {
  "format": "VOL {volume}%",
  "format-muted": "MUTED",
  "scroll-step": 5,
  "on-click": "pavucontrol"
  },



  "disk": {
    "interval": 25,
    "format": "󰋊 {percentage_used}%",
    "path": "/"
  },

  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },

  "memory": {
    "interval": 2,
    "format": "RAM {}%"
  },

  "cpu": {
    "interval": 2,
    "format": "CPU {usage}%"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀 Connected",
    "format-disconnected": "󰖪 Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click-right": "nm-connection-editor"
  },

  "battery": {
    "states": {
      "warning": 20,
      "critical": 10
    },

    "format": "BAT {capacity}%",
    "format-charging": "CHAR {capacity}%",
    "format-warning": "LOW {capacity}%",

    "interval": 5
  },

  "clock": {
    "interval": 1,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%Y-%m-%d %H:%M:%S}"
  }
}
