// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": "Catppuccin Mocha",
  "cli_default_open_behavior": "existing_window",
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "agent": {
    "default_profile": "write",
    "dock": "left",
    "default_model": {
      "provider": "ollama",
      "model": "gemma4:e4b",
      "enable_thinking": true
    },
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 16.0,
    "line_height": {
      "custom": 1.5
    }
  },
  "base_keymap": "VSCode",
  "preview_tabs": {
    "enable_preview_from_file_finder": false
  },
  "search": {
    "include_ignored": false
  },
  "multi_cursor_modifier": "cmd_or_ctrl",
  "sticky_scroll": {
    "enabled": false
  },
  "mouse_wheel_zoom": true,
  "minimap": {
    "show": "never"
  },
  "hover_popover_delay": 1000,
  "selection_highlight": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_fallbacks": [
    "JetBrains Mono",
    "Fira Code"
  ],
  "buffer_font_family": "Geist Mono",
  "file_types": {
    "solidity": [
      "*.sol"
    ]
  },
  "ensure_final_newline_on_save": true,
  "indent_guides": {
    "enabled": false
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },


  
  "soft_wrap": "editor_width"

}
