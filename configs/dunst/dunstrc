[global]
origin = top-center
offset = 0x40
width = 300
height = 100
transparency = 10
frame_width = 2
corner_radius = 10
font = JetBrainsMono Nerd Font 10
markup = full
format = "<b>%s</b>\n%b"
alignment = center
show_age_threshold = 60
word_wrap = yes
ignore_newline = no
stack_duplicates = false
hide_duplicate_count = true
show_indicators = no
separator_height = 2

[urgency_low]
timeout = 3

[urgency_normal]
timeout = 3

[urgency_critical]
timeout = 0
